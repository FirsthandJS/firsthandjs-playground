{
  "name": "firsthandjs-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Write Firsthand in the browser: a file, an editor, and the page it makes, side by side.",
  "license": "MIT",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "vite build",
    "generate": "node scripts/build-runtime.mjs && node scripts/collect-types.mjs",
    "preview": "vite preview",
    "precheck": "npm run generate",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run generate"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.6",
    "@firsthandjs/data": "^0.12.2",
    "@firsthandjs/deep": "^0.12.2",
    "@firsthandjs/dom": "^0.12.2",
    "@firsthandjs/i18n": "^0.12.2",
    "@firsthandjs/router": "^0.12.2",
    "@firsthandjs/styled": "^0.12.2",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.55.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firsthandjs/compiler": "^0.12.2",
    "@firsthandjs/jsx-runtime": "^0.12.2",
    "@firsthandjs/testing": "^0.12.2",
    "@playwright/test": "^1.63.0",
    "@types/babel__standalone": "^7.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
